{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "sh \"/absolute/path/to/armis-appsec-mcp/hooks/run-hook.sh\" cursor_pre_tool.py",
        "matcher": "\\b[Gg][Ii][Tt]\\b|\\b[Gg][Hh]\\b|[Ss][Cc][Aa][Nn]-[Pp]|[Aa][Rr][Mm][Ii][Ss]-~",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "sh \"/absolute/path/to/armis-appsec-mcp/hooks/run-hook.sh\" cursor_pre_tool.py",
        "matcher": "Write|Edit",
        "timeout": 5
      }
    ]
  }
}
