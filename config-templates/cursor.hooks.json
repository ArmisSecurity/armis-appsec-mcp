{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ". \"/absolute/path/to/armis-appsec-mcp/hooks/find-python.sh\" && run_hook \"/absolute/path/to/armis-appsec-mcp/hooks/cursor_pre_tool.py\"",
        "matcher": "\\b[Gg][Ii][Tt]\\b|\\b[Gg][Hh]\\b|[Ss][Cc][Aa][Nn]-[Pp]|[Aa][Rr][Mm][Ii][Ss]-~",
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": ". \"/absolute/path/to/armis-appsec-mcp/hooks/find-python.sh\" && run_hook \"/absolute/path/to/armis-appsec-mcp/hooks/cursor_pre_tool.py\"",
        "matcher": "Write|Edit",
        "timeout": 5
      }
    ]
  }
}
