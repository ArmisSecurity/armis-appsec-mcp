{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": ". \"/absolute/path/to/armis-appsec-mcp/hooks/find-python.sh\" && run_hook \"/absolute/path/to/armis-appsec-mcp/hooks/codex_pre_tool.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_file|apply_patch|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": ". \"/absolute/path/to/armis-appsec-mcp/hooks/find-python.sh\" && run_hook \"/absolute/path/to/armis-appsec-mcp/hooks/codex_pre_tool.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
