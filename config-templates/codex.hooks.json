{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "shell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"/absolute/path/to/armis-appsec-mcp/hooks/run-hook.sh\" codex_pre_tool.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_file|apply_patch|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"/absolute/path/to/armis-appsec-mcp/hooks/run-hook.sh\" codex_pre_tool.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
